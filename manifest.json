{
  "id": "SteamAutoCrack",
  "name": "SteamAutoCrack",
  "version": "3.4.0",
  "api_version": 1,
  "type": "generic",
  "enabled": true,
  "repository": "swolfgang-dev/playlite-plugin-steamautocrack",
  "minimum_playlite_version": "0.2.88",
  "description": "Process Windows games with an isolated Wine CLI container and verified original-file recovery, without a VM.",
  "installation_hooks": true,
  "settings_groups": [
    "SteamAutoCrack"
  ],
  "game_fields": [
    {
      "key": "SteamId",
      "label": "Steam ID",
      "metadata_provider": "SteamMetadata",
      "positive_id": true
    }
  ],
  "plugin_dependencies": [
    {
      "id": "SteamDepotDownloader",
      "repository": "swolfgang-dev/playlite-plugin-steam-depot-downloader",
      "minimum_version": "0.1.18"
    },
    {
      "id": "CrackTools",
      "repository": "swolfgang-dev/playlite-plugin-crack-tools",
      "minimum_version": "0.2.1"
    }
  ]
}
